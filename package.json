{
  "name": "the-diat-converter",
  "version": "0.1.0",
  "private": true,
  "description": "A local, offline file converter for Windows and macOS.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:mac": "npm run build && node scripts/prepare-universal.mjs && electron-builder --mac --universal",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps && node scripts/fetch-binaries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheTank87/FileConverter.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/TheTank87/FileConverter/issues"
  },
  "homepage": "https://github.com/TheTank87/FileConverter#readme",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
